# traefik-viewer secrets — example. Copy to .env and fill in as needed.
#   cp .env.example .env
#
# .env is gitignored. Values here are referenced from config.yaml via ${VAR}.
# Per-instance /api credentials are OPTIONAL — if your downstream /api is open
# (no auth), leave them blank. The config's ${VAR:-} defaults mean an empty
# value simply sends no auth header. Fill them in when /api is behind basicAuth.
#
# The variable names must match the ${...} references in your config. The names
# below correspond to the instances in config.example.yaml (gateway, node-01,
# node-02); rename to match your own config.

# --- gateway ---
GATEWAY_API_USER=admin
GATEWAY_API_PASS=

# --- node-01 ---
NODE01_API_USER=admin
NODE01_API_PASS=

# --- node-02 ---
NODE02_API_USER=admin
NODE02_API_PASS=

# --- Loki (optional; empty disables the Logs tab) ---
LOKI_URL=                      # e.g. http://loki:3100
LOKI_USER=
LOKI_PASS=

# --- Authentik (optional; only if authentik.url is set) ---
# Base URL of the authentik server (serves /api/v3/), e.g. https://auth.example.com
AUTHENTIK_URL=
# Read-only API token (authentik: Directory → Tokens → Create, intent "API")
AUTHENTIK_TOKEN=

# --- Instance admin UI (optional) ---
# Comma-separated authentik group names allowed to add/edit/remove Traefik
# instances from Settings → Instances (POST/PUT/DELETE /api/instances).
# Checked against the upstream forward-auth proxy's X-authentik-groups
# header — see docs/authentik.md §5. Leave empty to disable instance editing
# entirely (the default; fails closed, not open).
TV_ADMIN_GROUPS=
# Where UI-driven instance edits are persisted (a JSON file layered on top of
# config.yaml/.env at runtime; config.yaml itself is never modified). Must be
# a writable path — compose.yaml mounts a dedicated volume at /data for this.
# TV_OVERRIDES_PATH=/data/overrides.json
